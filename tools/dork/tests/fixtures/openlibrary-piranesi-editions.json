son"},{"role":"Producer","name":"Alex Raymond"},{"role":"Distributors","name":"Libro.fm"}],"languages":[{"key":"/languages/eng"}],"notes":{"type":"/type/text","value":"Duration:  25,122 seconds"},"physical_format":"eAudiobook","latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2025-12-27T20:28:53.522295"},"last_modified":{"type":"/type/datetime","value":"2025-12-27T20:33:43.329358"}},{"works":[{"key":"/works/OL20893680W"}],"title":"Piranesi","publishers":["Bloomsbury"],"publish_date":"2020","key":"/books/OL58608380M","type":{"key":"/type/edition"},"identifiers":{},"isbn_13":["9781526622440"],"physical_format":"eBook","covers":[15215371],"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2025-04-26T08:34:48.888664"},"last_modified":{"type":"/type/datetime","value":"2026-04-26T08:15:16.145051"}},{"works":[{"key":"/works/OL20893680W"}],"title":"Piranesi","publishers":["Bloomsbury Publishing"],"publish_date":"2021","key":"/books/OL57673846M","type":{"key":"/type/edition"},"covers":[15248718],"isbn_13":["9781635575644"],"physical_format":"eBook","number_of_pages":272,"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2025-02-05T19:19:08.300336"},"last_modified":{"type":"/type/datetime","value":"2026-08-26T15:08:20.926527"}},{"works":[{"key":"/works/OL20893680W"}],"title":"Piranesi","publishers":["Heyne"],"publish_date":"09.05.2022","key":"/books/OL51561069M","type":{"key":"/type/edition"},"identifiers":{},"covers":[14609166],"isbn_13":["9783453321984"],"classifications":{},"physical_dimensions":"18.5 x 11.8 x 2.6 centimeters","weight":"250 grams","contributors":[{"role":"Translator","name":"Astrid Finke"}],"description":{"type":"/type/text","value":"Ein riesiges Gebäude, in dem sich endlos Räume aneinanderreihen, verbunden durch ein Labyrinth aus Korridoren und Treppen. An den Wänden stehen Tausende Statuen, das Erdgeschoss besteht aus einem Ozean, bei Flut donnern die Wellen die Treppenhäuser hinauf. In diesem Gebäude lebt Piranesi. Er hat sein Leben der Erforschung des Hauses gewidmet. Und je weiter er sich in die Zimmerfluchten vorwagt, desto näher kommt er der Wahrheit – der Wahrheit über die Welt jenseits des Gebäudes. Und der Wahrheit über sich selbst."},"number_of_pages":272,"pagination":"272","latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2024-04-09T08:24:09.349721"},"last_modified":{"type":"/type/datetime","value":"2024-04-09T08:25:46.740993"}},{"type":{"key":"/type/edition"},"title":"Piranesi","authors":[{"key":"/authors/OL1387961A"}],"publish_date":"November 22, 2021","source_records":["amazon:6586015316"],"physical_format":"hardcover","notes":"Source title: Piranesi (Em Portugues do Brasil)","full_title":"Piranesi","covers":[13866011],"works":[{"key":"/works/OL20893680W"}],"key":"/books/OL47322902M","identifiers":{},"isbn_10":["6586015316"],"isbn_13":["9786586015317"],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2023-04-08T19:13:45.971662"},"last_modified":{"type":"/type/datetime","value":"2025-05-24T09:26:52.576470"}},{"type":{"key":"/type/edition"},"title":"Piranesi","authors":[{"key":"/authors/OL1387961A"},{"key":"/authors/OL8477044A"}],"publish_date":"Sep 13, 2021","source_records":["amazon:8417918485"],"number_of_pages":276,"publishers":["Amsterdam"],"physical_format":"paperback","full_title":"Piranesi Piranesi","notes":{"type":"/type/text","value":"Source title: Piranesi"},"covers":[13228480],"works":[{"key":"/works/OL20893680W"}],"key":"/books/OL46535148M","identifiers":{},"classifications":{},"isbn_10":["8417918485"],"isbn_13":["9788417918484"],"languages":[{"key":"/languages/eng"}],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2023-02-03T10:49:55.438162"},"last_modified":{"type":"/type/datetime","value":"2024-03-09T14:35:55.700925"}},{"type":{"key":"/type/edition"},"title":"Piranèse","authors":[{"key":"/authors/OL1387961A"},{"key":"/authors/OL3128222A"}],"publish_date":"Oct 07, 2021","source_records":["amazon:2221250249"],"number_of_pages":306,"publishers":["ROBERT LAFFONT"],"isbn_10":["2221250249"],"isbn_13":["9782221250242"],"physical_format":"paperback","full_title":"Piranèse","works":[{"key":"/works/OL20893680W"}],"key":"/books/OL37069540M","latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2022-02-19T16:38:31.541797"},"last_modified":{"type":"/type/datetime","value":"2023-02-12T15:23:20.674469"}},{"works":[{"key":"/works/OL20893680W"}],"title":"Piranesi","publishers":["Fazi Editore"],"publish_date":"February 4, 2021","key":"/books/OL39864438M","type":{"key":"/type/edition"},"identifiers":{},"classifications":{},"covers":[12953670],"series":["Lainya"],"translation_of":"Piranesi","languages":[{"key":"/languages/ita"}],"translated_from":[{"key":"/languages/eng"}],"number_of_pages":300,"physical_format":"eBook","publish_places":["Rome, Italy"],"contributors":[{"role":"Translator","name":"Donatella Rzzati"}],"description":{"type":"/type/text","value":"**Traduzione di Donatella Rizzati**\r\n\r\nPiranesi vive nella Casa. Forse da sempre. Giorno dopo giorno ne esplora gli infiniti saloni, mentre nei suoi diari tiene traccia di tutte le meraviglie e i misteri che questo mondo labirintico custodisce. I corridoi abbandonati conducono in un vestibolo dopo l’altro, dove sono esposte migliaia di bellissime statue di marmo. Imponenti scalinate in rovina portano invece ai piani dove è troppo rischioso addentrarsi: fitte coltri di nubi nascondono allo sguardo il livello superiore, mentre delle maree imprevedibili che risalgono da chissà quali abissi sommergono i saloni inferiori.\r\nOgni martedì e venerdì Piranesi si incontra con l’Altro per raccontargli le sue ultime scoperte. Quest’uomo enigmatico è l’unica persona con cui parla, perché i pochi che sono stati nella Casa prima di lui sono ora soltanto scheletri che si confondono tra il marmo.\r\nImprovvisamente appaiono dei messaggi misteriosi: qualcuno è arrivato nella Casa e sta cercando di mettersi in contatto proprio con Piranesi. Di chi si tratta? Lo studioso spera in un nuovo amico, mentre per l’Altro è solo una terribile minaccia. Piranesi legge e rilegge i suoi diari ma i ricordi non combaciano, il tempo sembra scorrere per conto proprio e l’Altro gli confonde solo le idee con le sue risposte sfuggenti. Piranesi adora la Casa, è la sua divinità protettrice e l’unica realtà di cui ha memoria. È disposto a tutto per proteggerla, ma il mondo che credeva di conoscere nasconde ancora troppi segreti e sta diventando, suo malgrado, pericoloso.\r\nSusanna Clarke, autrice fantasy fra le più acclamate, torna in maniera trionfale con un nuovo, inebriante romanzo ambientato in un mondo da sogno intriso di bellezza e poesia.\r\n\r\n**«*Piranesi* mi ha sbalordita. È un esempio di storytelling miracoloso e luminoso».**\r\n**Madeline Miller**\r\n\r\n**«Un avvincente, suggestivo mistero. Questo libro è un tesoro trasportato dal mare su una costa dimenticata, che attende solo di essere scoperto».**\r\n**Erin Morgenstern**\r\n\r\n**«Che mondo ha creato Susanna Clarke… *Piranesi* è un puzzle squisito».**\r\n**David Mitchell**\r\n\r\n**«Ci riporta decisamente a *Sogno di una notte di mezza estate*, per non parlare de *La tempesta*. Susanna è una di quegli scrittori che usano gli strumenti della fantasia per parlarci di noi stessi».**\r\n**Neil Gaiman**\r\n\r\n**«La pubblicazione di *Piranesi* conferma che Susanna Clarke è fra i più grandi e interessanti scrittori di fantasy degli ultimi cent’anni o più».**\r\n**«Times Literary Supplement»**"},"isbn_13":["9791259670021"],"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2022-10-17T11:48:41.081614"},"last_modified":{"type":"/type/datetime","value":"2024-04-07T17:22:26.433879"}},{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL1387961A"}],"isbn_13":["9781526631008"],"languages":[{"key":"/languages/eng"}],"pagination":"245","publish_date":"2020","publishers":["Bloomsbury Publishing Plc"],"source_records":["bwb:9781526631008"],"title":"Piranesi","full_title":"Piranesi","works":[{"key":"/works/OL20893680W"}],"key":"/books/OL36769135M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-01-27T18:51:49.158856"},"last_modified":{"type":"/type/datetime","value":"2022-01-27T18:51:49.158856"}},{"type":{"key":"/type/edition"},"title":"Piranesi","authors":[{"key":"/authors/OL1387961A"}],"publish_date":"Aug 19, 2021","source_records":["amazon:1526622432","promise:bwb_daily_pallets_2022-07-11"],"publishers":["BLOOMSBURY"],"isbn_10":["1526622432"],"isbn_13":["9781526622433"],"physical_format":"paperback","full_title":"Piranesi","covers":[11996540],"works":[{"key":"/works/OL20893680W"}],"key":"/books/OL33884545M","local_id":["urn:bwbsku:KQ-842-249"],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2021-09-25T09:10:05.763194"},"last_modified":{"type":"/type/datetime","value":"2022-12-05T00:00:27.545499"}},{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL1387961A"}],"isbn_13":["9781432895082"],"languages":[{"key":"/languages/eng"}],"publish_date":"2022","publishers":["Thorndike Press","Large Print Press"],"source_records":["bwb:9781432895082","amazon:1432895087"],"title":"Piranesi","full_title":"Piranesi","works":[{"key":"/works/OL20893680W"}],"key":"/books/OL36128954M","covers":[13652251],"number_of_pages":335,"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2021-12-28T14:04:13.178012"},"last_modified":{"type":"/type/datetime","value":"2023-03-19T08:18:11.544802"}},{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL1387961A"}],"languages":[{"key":"/languages/spa"}],"publish_date":"2021-12-07","publishers":["Salamandra"],"source_records":["bwb:9788418363283"],"subjects":["Fiction, fantasy, dark fantasy"],"title":"Piranesi","weight":"12.6 ounces","pagination":"272p.","full_title":"Piranesi","works":[{"key":"/works/OL20893680W"}],"key":"/books/OL34985598M","covers":[15240267,12317539],"identifiers":{},"physical_dimensions":"8.65 x 5.44 x 0.73 inches","publish_places":["Barcelona, Spain"],"edition_name":"Spanish Edition","contributors":[{"role":"Translator","name":"Antonio Padilla Esteban"}],"by_statement":"by Susanna Clarke","translation_of":"Piranesi","description":"**Bestseller del *New York Times***\r\n**Ganador del Women's Prize for Fiction**\r\n**Finalista de World Fantasy Awards**\r\n\r\n**Vuelve la autora de *Jonathan Strange y el señor Norrell* con una novela hipnótica ambientada en una realidad onírica.**\r\n\r\nLa casa de Piranesi no es un edificio cualquiera: sus habitaciones son monumentales, con paredes llenas de miles de estatuas, y sus pasillos, interminables. Dentro del dédalo de corredores hay un océano aprisionado en el que las olas retumban y las mareas inundan los aposentos. Pero Piranesi no tiene miedo: comprende las embestidas del mar igual que el patrón del laberinto, mientras explora los límites de su mundo y avanza, con la ayuda de un hombre llamado El Otro, en una investigación científica para alcanzar El Gran Conocimiento Secreto.","physical_format":"Paperback","number_of_pages":272,"isbn_10":["8418363282"],"isbn_13":["9788418363283"],"oclc_numbers":["1286751587"],"translated_from":[{"key":"/languages/eng"}],"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2021-10-09T17:49:26.733686"},"last_modified":{"type":"/type/datetime","value":"2026-07-22T22:02:20.805176"}},{"works":[{"key":"/works/OL20893680W"}],"title":"Piranesi","publishers":["Bloomsbury Publishing"],"publish_date":"2 Sept. 2021","key":"/books/OL33926341M","type":{"key":"/type/edition"},"identifiers":{},"classifications":{},"copyright_date":"2020","description":"WINNER OF THE WOMEN'S PRIZE 2021","source_records":["bwb:9781526622433"],"covers":[12498884],"isbn_13":["9781526622433"],"isbn_10":["1526622432"],"lc_classifications":["PR6103.L375"],"t