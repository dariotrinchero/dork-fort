#!/usr/bin/env python3
# Launcher for dork, to symlink onto PATH (eg. ln -s "$PWD/tools/dork/bin/dork" ~/.local/bin/dork); it finds its
# package, & through it the vault, from its own real path.

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from dork.__main__ import main

sys.exit(main())
